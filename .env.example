# Copy to .env and fill in values. Never commit .env.

# PostgreSQL (host port 5433 maps to container 5432)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=uitbot
POSTGRES_USER=uitbot_user
POSTGRES_PASSWORD=change_me

# OpenAI-compatible gateway (used from Phase 3)
OPENAI_API_KEY=
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=

# Langfuse is optional. Leave empty to disable tracing.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# Embedding (dimension is detected from the loaded model)
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=16

# Chunking
CHUNK_STRATEGY=fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=150
CHUNK_SENTENCE_OVERLAP=1

# OCR: tesseract | none  (falls back to none if Tesseract is missing)
OCR_ENGINE=tesseract
OCR_MIN_CHARS=50
OCR_REPLACEMENT_CHAR_RATIO=0.02
OCR_MIN_VIETNAMESE_RATIO=0.15
OCR_LOW_CONFIDENCE=60
OCR_DPI=300

# Retrieval & Reranker
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true
RERANKER_BATCH_SIZE=16
RETRIEVAL_CANDIDATE_COUNT=20
RRF_K=60
BM25_TOKENIZER=underthesea

# App
DEBUG=true
HOST=0.0.0.0
PORT=8000
